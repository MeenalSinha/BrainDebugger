# BrainDebugger — Environment Configuration
# Copy to .env and fill in values. Do NOT commit .env to source control.

# ── Data directory ────────────────────────────────────────────────────────────
# Absolute path to the directory containing MaleCNS v1.0 Feather files.
# The files must be named exactly as downloaded from the Janelia FlyEM site.
# Default: ./data (relative to project root)
DATA_DIR=./data

# ── neuPrint API (optional) ───────────────────────────────────────────────────
# Leave blank to use only the local Feather files.
# If set, all three values must be provided together.
NEUPRINT_SERVER=https://neuprint.janelia.org
NEUPRINT_DATASET=male-cns:v1.0
NEUPRINT_TOKEN=

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_SEARCH_RESULTS=100
MAX_CONNECTIONS=500
MAX_GRAPH_NODES=150
HTTP_TIMEOUT=30

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
